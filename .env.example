# Public configuration: never use a privileged key in a NEXT_PUBLIC variable.
# CLI anon key is allowed only with the local Supabase URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact app origin for email links; HTTPS outside local development.
SITE_URL=

# Server-only key for private attachment bytes and trusted completion; never sent to a browser.
SUPABASE_STORAGE_SECRET_KEY=

# Server-only maintenance authorization; use a random value of at least 32 characters.
CRON_SECRET=
