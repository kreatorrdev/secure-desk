    "check:organizations:projects:web": "node scripts/check-organization-projects-web.mjs",
    "test:attachments": "node --test scripts/attachment-validation.test.mjs",
    "check:organizations:proposals:web": "node scripts/check-organization-proposals-web.mjs",
    "check:tickets:web": "node scripts/check-tickets-web.mjs",
    "check:tickets:attachments:web": "node scripts/check-ticket-attachments-web.mjs",
    "check:tickets:resolution:web": "node scripts/check-ticket-resolution-web.mjs",
    "check:tickets:autoclose:local": "node scripts/check-ticket-auto-close.mjs",
    "check:audit:web": "node scripts/check-audit-web.mjs",
    "check:gate5:local": "node scripts/check-gate5-local.mjs",
    "test:security:controls": "node --test scripts/security-controls.test.mjs",
    "check:security:web": "node scripts/check-security-web.mjs",
