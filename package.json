    "check:auth:web": "node scripts/check-auth-web.mjs",
    "admin:bootstrap:local": "node scripts/bootstrap-local-super-admin.mjs",
    "test:admin:guards": "node --test scripts/bootstrap-local-super-admin.test.mjs",
    "check:registration:local": "node scripts/check-registration-review.mjs",
    "check:registration:web": "node scripts/check-registration-review-web.mjs",
    "check:registration:retry:web": "node scripts/check-own-registration-retry-web.mjs",
    "check:access:local": "node scripts/check-access-management.mjs",
    "check:access:web": "node scripts/check-access-management-web.mjs",
    "check:gate2:local": "node scripts/check-gate2-local.mjs",
    "check:organizations:web": "node scripts/check-organizations-web.mjs",
